{
  "schemaVersion": 1,
  "id": "breedtimer",
  "version": "${version}",
  "name": "BreedTimer",
  "description": "Shows floating timers above breedable animals indicating when they can breed again.",
  "authors": ["Dennis_thegamer"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/breedtimer/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["de.dennisthegamer.breedtimer.fabric.BreedTimerFabric"],
    "modmenu": ["de.dennisthegamer.breedtimer.fabric.ModMenuIntegration"]
  },
  "mixins": ["breedtimer.mixins.json"],
  "depends": {
    "fabricloader": "${fabricloader_dep}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dep}",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": ">=11.0.0",
    "yet_another_config_lib": ">=3.8.2"
  }
}
